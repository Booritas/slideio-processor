BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"slideio/processor/'
    Priority: 2
  - Regex: '^<slideio/processor/'
    Priority: 2
  - Regex: '^<[a-z_]+\.h>|^<[a-z_/]+>$'
    Priority: 4
  - Regex: '^<.*'
    Priority: 3
  - Regex: '^".*'
    Priority: 2
